digraph SAR_Architecture {
    rankdir=LR;
    node [fontname="Helvetica", shape=box];
    edge [fontname="Helvetica", fontsize=10];
    
    subgraph cluster_inputs {
        label="Inputs";
        style=dashed;
        clk [shape=rarrow, fillcolor=lightgray, style=filled];
        rst_n [shape=rarrow, fillcolor=lightgray, style=filled];
        start [shape=rarrow, fillcolor=lightgray, style=filled];
        comp_out [shape=rarrow, fillcolor=lightgray, style=filled];
    }

    subgraph cluster_outputs {
        label="Outputs";
        style=dashed;
        eoc [shape=rarrow, fillcolor=lightgray, style=filled];
        busy [shape=rarrow, fillcolor=lightgray, style=filled];
        dout_valid [shape=rarrow, fillcolor=lightgray, style=filled];
        dac_out_port [shape=rarrow, fillcolor=lightgray, style=filled, label="dac_out[N-1:0]"];
        dout_port [shape=rarrow, fillcolor=lightgray, style=filled, label="dout[N-1:0]"];
    }

    subgraph cluster_control {
        label="Control Path";
        style=filled; fillcolor=aliceblue; color=blue;
        ControlUnit [shape=Mrecord, fillcolor=lightblue, style=filled, label="{ FSM & Control Logic | {IDLE | SAMPLE | CONVERT | DONE} }"];
    }

    subgraph cluster_datapath {
        label="Datapath";
        style=filled; fillcolor=honeydew; color=green;
        bit_idx [shape=record, fillcolor=lightgreen, style=filled, label="{ Bit Counter | bit_idx }"];
        sar_reg [shape=record, fillcolor=lightgreen, style=filled, label="{ SAR Register | sar_reg }"];
        dac_out_reg [shape=record, fillcolor=lightgreen, style=filled, label="{ DAC Output Reg | dac_out }"];
        dout_reg [shape=record, fillcolor=lightgreen, style=filled, label="{ Data Output Reg | dout }"];
    }

    // Input routing
    start -> ControlUnit;
    comp_out -> sar_reg [label="comp_out", style=bold];
    comp_out -> dac_out_reg [label="comp_out", style=bold];

    // Control to Datapath
    ControlUnit -> bit_idx [label="ld_MSB / dec", color=blue, fontcolor=blue, style=dashed];
    ControlUnit -> sar_reg [label="clr / set_bit", color=blue, fontcolor=blue, style=dashed];
    ControlUnit -> dac_out_reg [label="update_val", color=blue, fontcolor=blue, style=dashed];
    ControlUnit -> dout_reg [label="load_val", color=blue, fontcolor=blue, style=dashed];
    
    // Feedback from Datapath to Control
    bit_idx -> ControlUnit [label="bit_idx == 0", color=red, fontcolor=red, style=bold];

    // Datapath internal routing
    bit_idx -> sar_reg [label="idx", style=bold];
    bit_idx -> dac_out_reg [label="idx", style=bold];
    sar_reg -> dac_out_reg [label="sar_reg", style=bold];
    sar_reg -> dout_reg [label="sar_reg", style=bold];

    // Outputs routing
    ControlUnit -> eoc [color=blue];
    ControlUnit -> busy [color=blue];
    ControlUnit -> dout_valid [color=blue];
    dac_out_reg -> dac_out_port [style=bold];
    dout_reg -> dout_port [style=bold];
    
    // Optional global routing (clk/rst_n) for completeness
    clk -> ControlUnit [style=dotted, color=gray];
    rst_n -> ControlUnit [style=dotted, color=gray];
    clk -> bit_idx [style=dotted, color=gray];
    clk -> sar_reg [style=dotted, color=gray];
    clk -> dac_out_reg [style=dotted, color=gray];
    clk -> dout_reg [style=dotted, color=gray];
}
