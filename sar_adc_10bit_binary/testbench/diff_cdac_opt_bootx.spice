x1 VOUT_P VCM_EN VCM_EN_B VCM_P VDD VSS top_nmos_switch
XMN_dum_x1 VOUT_P VCM_EN_B VOUT_P VSS nfet_03v3 L=0.28u W=10u nf=4 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)' ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
